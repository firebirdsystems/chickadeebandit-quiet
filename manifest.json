{
  "id": "quiet-time",
  "contexts": ["household", "shared_space"],
  "name": "Quiet Time",
  "version": "1.0.3",
  "description": "Family quiet time game — who can be the most silent?",
  "companion_app": {
    "name": "Chickadee Quiet",
    "tagline": "Play quiet-time sessions from your own phone",
    "android_url": "https://play.google.com/store/apps/details?id=net.firebirdsystems.chickadeebandit.quiettime",
    "ios_url": "https://apps.apple.com/us/app/chickadee-quiet/id6776810241"
  },
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["game", "family", "kids"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
    "member_references": {
      "qt_sessions": [
        {
          "column": "created_by",
          "on_removed": "keep"
        },
        {
          "column": "specific_member_ids",
          "on_removed": "prune_list"
        }
      ],
      "qt_participants": {
        "column": "member_id",
        "on_removed": "delete"
      },
      "qt_readings": {
        "column": "member_id",
        "on_removed": "delete"
      }
    },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "retention": {
    "qt_sessions": {
      "default": 365,
      "timestamp_column": "started_at",
      "override_key": "session_history",
      "dependent_tables": [
        { "table": "qt_participants", "foreign_key": "session_id" }
      ]
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_quiet_time__qt_sessions WHERE status = 'active' LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "quiet time running",
      "severity": "info"
    }
  },
  "row_policies": {
    "qt_participants": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true
    },
    "qt_readings": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "retain_days": { "default": 90, "timestamp_column": "recorded_at", "override_key": "reading_history",
        "tier": "operational" }
    }
  },
  "publish_acls": {
    "quiet-time.session-started": { "require_role": "adult" },
    "quiet-time.session-cancelled": { "require_role": "adult" },
    "game.completed": { "require_role": "adult" }
  },
  "nav": { "label": "Quiet Time" },
  "icon": "🤫",
  "publishes": [
    "quiet-time.session-started",
    "quiet-time.session-activated",
    "quiet-time.session-cancelled",
    "quiet-time.session-completed",
    "game.completed"
  ],
  "alert_on": ["quiet-time.session-started"]
}
